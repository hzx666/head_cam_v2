# PostgreSQL 连接配置模板
# 用法：复制本文件为 tools/db.env，填入实际值后保存。
#   cp tools/db.env.example tools/db.env
# tools/db.env 已在 .gitignore 中，请勿提交、勿贴在对话里。
# 脚本读取顺序：环境变量 > tools/db.env。

DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=
# psycopg sslmode: prefer / require / disable / allow / verify-full
DB_SSLMODE=prefer
